# ==============================================================================
# JuriMbrella — Environment Configuration Template
# NOTE: Never commit real credentials or private keys to git.
# ==============================================================================

# Server & Runtime
PORT=3000
NODE_ENV=production
APP_ENV=production

# Database (PostgreSQL Production Connection String)
# Example: postgresql://username:password@hostname:5432/jurimbrella_prod?sslmode=require
DATABASE_URL=

# Frontend API URL (Configured in client build when frontend is hosted separately on GitHub Pages)
# Example: https://api.jurimbrella.ph
VITE_API_BASE_URL=

# Cross-Origin Resource Sharing (Production Origin)
# Example: https://barin-law.github.io
CORS_ORIGIN=https://barin-law.github.io

# First Administrator Provisioning Master Token
# Used to initialize the primary administrator via POST /api/auth/setup-admin
ADMIN_SETUP_TOKEN=

# Session Encryption & Cryptographic Seeds
SESSION_SECRET=

# Email Provider Configuration (SMTP / SendGrid / Postmark)
EMAIL_PROVIDER=
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SUPPORT_EMAIL=support@jurimbrella.ph
FINANCE_EMAIL=finance@jurimbrella.ph

# Object Storage for Documents & Encrypted Payment Proofs (AWS S3 / GCS)
FILE_STORAGE_BUCKET=
FILE_STORAGE_KEY=
EVIDENCE_BUCKET=
RECORDING_BUCKET=

# Supreme Court Accreditation & Cryptographic HSM Endpoints
ACCREDITATION_NUMBER=
ACCREDITATION_STATUS=
ACCREDITATION_EFFECTIVE_AT=
ACCREDITATION_EXPIRES_AT=
ADMIN_CONTACT_URL=
HSM_SIGNING_KEY_RESOURCE=
KMS_KEY_RESOURCE=
TIMESTAMP_AUTHORITY_URL=
CERTIFICATE_STATUS_ENDPOINT=
WEBHOOK_SIGNING_KEY=
