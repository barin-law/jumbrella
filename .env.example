# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Barin ENF Environment and Accreditation Configuration
APP_ENV="development"
PUBLIC_APP_URL="http://localhost:3000"
ACCREDITATION_STATUS="CANDIDATE"
ACCREDITATION_NUMBER=""
ACCREDITATION_EFFECTIVE_AT=""
ACCREDITATION_EXPIRES_AT=""

# Cloud Infrastructure
FIREBASE_PROJECT_ID=""
GOOGLE_CLOUD_PROJECT=""
EVIDENCE_BUCKET=""
RECORDING_BUCKET=""

# Cryptography & HSM
KMS_KEY_RESOURCE=""
HSM_SIGNING_KEY_RESOURCE=""
TIMESTAMP_AUTHORITY_URL=""
CERTIFICATE_STATUS_ENDPOINT=""

# External Identity & Scanners
IDENTITY_PROVIDER_BASE_URL=""
IDENTITY_PROVIDER_CLIENT_ID=""
IDENTITY_PROVIDER_CLIENT_SECRET=""
MALWARE_SCANNER_ENDPOINT=""
MALWARE_SCANNER_SECRET=""

# Real-time Video Provider (WebRTC)
VIDEO_PROVIDER_BASE_URL=""
VIDEO_PROVIDER_API_KEY=""
VIDEO_PROVIDER_API_SECRET=""

# Supreme Court Regulatory Adapter
COURT_ADAPTER_BASE_URL=""
COURT_ADAPTER_CLIENT_ID=""
COURT_ADAPTER_CLIENT_SECRET=""

# Communications & Payments
PAYMENT_PROVIDER_SECRET=""
EMAIL_PROVIDER_SECRET=""
SMS_PROVIDER_SECRET=""
WEBHOOK_SIGNING_KEY=""

# Barin Assistant Provider-Independent AI Gateway
AI_PROVIDER="gemini"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
LEGAL_RETRIEVAL_API_URL=""
LEGAL_RETRIEVAL_API_KEY=""
ADMIN_CONTACT_URL="mailto:admin@demo-barinlaw.ph"
FREE_CREDIT_LIMIT="3"
DAILY_MESSAGE_LIMIT="3"
MONTHLY_MESSAGE_LIMIT="10"

